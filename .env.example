# Optional durable state location. Default: .factory-data/workspace.json
# FACTORY_DATA_PATH=/var/lib/system-factory/workspace.json

# Required for a hosted production operator instance. Set with a secret manager.
# FACTORY_ACCESS_PASSWORD=

# LOOPBACK TESTING ONLY. Never use on an exposed deployment.
# FACTORY_LOCAL_ONLY=true

# Optional future integration adapters; unused in default mock mode.
# DATABASE_URL=
# OPENAI_API_KEY=
