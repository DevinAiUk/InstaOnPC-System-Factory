# AI generation, contact lookup, and operator chatbot (server secrets only).
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Sites sets FACTORY_HOST=sites and binds D1 automatically. Its private access gate protects the workspace.
# For the original non-Sites deployment, configure Basic Auth:
# FACTORY_ACCESS_PASSWORD=

# Optional signed ingress and exact outbound HTTPS destinations.
# FACTORY_WEBHOOK_SECRET=
# FACTORY_WEBHOOK_ALLOWLIST=https://crm.example.com/hooks/leads

# Optional Neon persistence for the original factory project store.
# DATABASE_URL=postgresql://user:password@host-pooler/database?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require

# Local tests only; never enable on an exposed deployment.
# FACTORY_LOCAL_ONLY=true
# FACTORY_DATA_PATH=/var/lib/system-factory/workspace.json
